{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "\"C:/Users/lalwa/bin/atlas.exe\" hook post-tool",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"C:/Users/lalwa/bin/atlas.exe\" hook guard",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "\"C:/Users/lalwa/bin/atlas.exe\" hook session-end",
            "timeout": 15,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"C:/Users/lalwa/bin/atlas.exe\" hook session-start",
            "timeout": 15,
            "type": "command"
          }
        ]
      }
    ]
  }
}
